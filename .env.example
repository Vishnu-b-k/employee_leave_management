# Environment configuration for Employee Leave Management System

# Environment & Server
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL 16 Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=leave_management
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Prisma Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leave_management?schema=public"

# Restricted DB User (for application runtime immutability enforcement)
APP_DB_USER=app_user
APP_DB_PASSWORD=app_secure_password

# Object Storage (MinIO / S3 - planned for next steps)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_DOCUMENTS=leave-documents
STORAGE_FORCE_PATH_STYLE=true

# Firebase Client Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-app.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Firebase Admin Configuration
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com
# For production: RSA private key (escaped with \n). For emulator: leave empty or use emulator host.
FIREBASE_PRIVATE_KEY=""
USE_FIREBASE_EMULATOR=false
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Session & Security
SESSION_COOKIE_NAME=leaveflow_session
SESSION_COOKIE_MAX_AGE_DAYS=5
CSRF_SECRET=leaveflow-csrf-secret-key-32-chars-min!

# Demo Account Credentials (Used for seeding and testing)
DEMO_EMPLOYEE_EMAIL=employee@leaveflow.internal
DEMO_EMPLOYEE_PASSWORD=EmployeePass123!
DEMO_MANAGER_EMAIL=manager@leaveflow.internal
DEMO_MANAGER_PASSWORD=ManagerPass123!
DEMO_HOD_EMAIL=hod@leaveflow.internal
DEMO_HOD_PASSWORD=HodPass123!
